<?php

declare(strict_types=1);

// `trunk serve` (PHP's built-in server) sends every request here; let it serve real files from public/
// (styles.css, script.js, images) itself. A web server such as nginx does this before PHP is involved.
if (\PHP_SAPI === 'cli-server') {
    $path = parse_url($_SERVER['REQUEST_URI'] ?? '/', \PHP_URL_PATH);
    $file = \is_string($path) ? realpath(__DIR__ . $path) : false;

    if ($file !== false && is_file($file) && str_starts_with($file, __DIR__ . \DIRECTORY_SEPARATOR) && !str_ends_with($file, '.php')) {
        return false;
    }
}

require __DIR__ . '/../vendor/autoload.php';

(new Trunk\Http\Kernel\WebEntry())->run(dirname(__DIR__));
