:root{
  color-scheme: light dark;
  --bg:#ececee;
  --bg-tint:rgba(255,255,255,.55);
  --surface:#ffffff;
  --surface-2:#f6f6f8;
  --border:rgba(17,18,20,.08);
  --border-strong:rgba(17,18,20,.12);
  --text:#17181a;
  --text-muted:#697086;
  --text-faint:#9aa0ae;
  --accent:#f97316;
  --accent-2:#ea580c;
  --green:#16a34a;
  --green-soft:#dcfce7;
  --amber:#b45309;
  --amber-soft:#fef3c7;
  --red:#dc2626;
  --red-soft:#fee2e2;
  --shadow-sm:0 1px 2px rgba(17,18,20,.05);
  --shadow-card:0 1px 3px rgba(17,18,20,.05), 0 12px 34px -16px rgba(17,18,20,.18);
  --wrap:1160px;

  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:border-box}

@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0d0e10;
    --bg-tint:rgba(255,255,255,.03);
    --surface:#17181b;
    --surface-2:#1e2024;
    --border:rgba(255,255,255,.09);
    --border-strong:rgba(255,255,255,.15);
    --text:#f2f3f5;
    --text-muted:#9aa0ae;
    --text-faint:#6b7280;
    --accent:#fb923c;
    --accent-2:#f97316;
    --green:#4ade80;
    --green-soft:rgba(74,222,128,.14);
    --amber:#fbbf24;
    --amber-soft:rgba(251,191,36,.14);
    --red:#f87171;
    --red-soft:rgba(248,113,113,.14);
    --shadow-sm:0 1px 2px rgba(0,0,0,.5);
    --shadow-card:0 1px 3px rgba(0,0,0,.5), 0 16px 44px -18px rgba(0,0,0,.7);
  }
}
:root[data-theme="dark"]{
  --bg:#0d0e10;
  --bg-tint:rgba(255,255,255,.03);
  --surface:#17181b;
  --surface-2:#1e2024;
  --border:rgba(255,255,255,.09);
  --border-strong:rgba(255,255,255,.15);
  --text:#f2f3f5;
  --text-muted:#9aa0ae;
  --text-faint:#6b7280;
  --accent:#fb923c;
  --accent-2:#f97316;
  --green:#4ade80;
  --green-soft:rgba(74,222,128,.14);
  --amber:#fbbf24;
  --amber-soft:rgba(251,191,36,.14);
  --red:#f87171;
  --red-soft:rgba(248,113,113,.14);
  --shadow-sm:0 1px 2px rgba(0,0,0,.5);
  --shadow-card:0 1px 3px rgba(0,0,0,.5), 0 16px 44px -18px rgba(0,0,0,.7);
}

html,body{height:100%}
body{
  margin:0;
  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  color:var(--text);
  background:
    radial-gradient(120% 80% at 50% -10%, var(--bg-tint), transparent 60%),
    var(--bg);
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
  display:flex;
  flex-direction:column;
  min-height:100%;
}
main{flex:1 0 auto}

/* shared content column so the card lines up edge-to-edge with the header */
.wrap{width:100%;max-width:var(--wrap);margin:0 auto;padding:0 26px}

/* ---- header (brand only, no nav) ---- */
.topbar{padding:18px 0}
.topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:11px;color:inherit;text-decoration:none}
.brand-name{font-weight:600;font-size:15.5px;letter-spacing:-.015em}
.tools{display:flex;align-items:center;gap:8px}
.chip{
  display:inline-flex;align-items:center;gap:8px;
  height:34px;padding:0 13px;border-radius:999px;
  background:var(--surface);border:1px solid var(--border);
  box-shadow:var(--shadow-sm);
  font-size:12.5px;font-weight:500;color:var(--text-muted);
  white-space:nowrap;
}
.chip .beat{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px var(--green-soft)}

/* ---- hero card: sits directly under the header, full content width ---- */
main{padding:2px 0 46px}
.card{
  width:100%;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:0;                 /* square, professional */
  box-shadow:var(--shadow-card);
  padding:46px 44px;
}

.status{
  display:inline-flex;align-items:center;gap:9px;
  height:30px;padding:0 14px 0 12px;border-radius:999px;
  background:var(--green-soft);color:var(--green);
  font-size:12.5px;font-weight:600;letter-spacing:-.005em;
  margin-bottom:22px;
}
.status.is-warn{background:var(--amber-soft);color:var(--amber);padding:0 14px}
.status.is-error{background:var(--red-soft);color:var(--red);padding:0 14px}
.status .pulse{position:relative;width:8px;height:8px;border-radius:50%;background:currentColor}
.status .pulse::after{
  content:"";position:absolute;inset:-4px;border-radius:50%;background:currentColor;
  opacity:.35;animation:pulse 2.4s ease-out infinite;
}
@keyframes pulse{0%{transform:scale(.55);opacity:.5}70%,100%{transform:scale(2);opacity:0}}

h1{
  margin:0 0 13px;
  font-size:35px;line-height:1.08;font-weight:700;letter-spacing:-.032em;
  color:var(--text);
}
.lead{margin:0;font-size:16px;line-height:1.68;color:var(--text-muted);max-width:52ch}
.lead a{color:var(--accent-2);text-decoration:none;font-weight:500}
.lead a:hover{text-decoration:underline}
.request-id{margin:22px 0 0;font-size:12.5px;color:var(--text-faint)}
.request-id code.path{cursor:text}
code.path{
  font-family:ui-monospace,'SF Mono','Cascadia Code',Menlo,Consolas,monospace;
  font-size:12.8px;color:var(--text);
  background:var(--surface-2);border:1px solid var(--border);
  padding:2px 7px;border-radius:6px;white-space:nowrap;cursor:pointer;
  transition:border-color .15s, color .15s;
}
code.path:hover{border-color:var(--border-strong)}
code.path.copied{border-color:var(--green);color:var(--green)}

/* ---- footer ---- */
footer{padding:16px 0 calc(22px + env(safe-area-inset-bottom,0px))}
.footer-inner{
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;
  color:var(--text-faint);font-size:12.5px;
}
.footer-inner .sep{opacity:.5;margin:0 8px}
.footer-inner .clock{font-variant-numeric:tabular-nums}

/* ---- copy toast ---- */
#toast{
  position:fixed;left:50%;bottom:26px;transform:translate(-50%,14px);
  background:var(--text);color:var(--surface);
  padding:9px 15px;border-radius:8px;font-size:13px;font-weight:500;
  box-shadow:var(--shadow-card);opacity:0;pointer-events:none;
  transition:opacity .2s, transform .2s;z-index:20;
}
#toast.show{opacity:1;transform:translate(-50%,0)}

@media (prefers-reduced-motion:no-preference){
  .card{animation:rise .5s cubic-bezier(.2,.7,.2,1) both}
}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

@media (max-width:520px){
  .wrap{padding:0 18px}
  .env-label{display:none}
  main{padding-bottom:40px}
  .card{padding:32px 24px}
  h1{font-size:28px}
  .lead{font-size:15px}
  .footer-inner{justify-content:center;text-align:center}
}
