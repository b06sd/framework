<layout name="app">
    <fill slot="title">{{ status }} {{ message }}</fill>

    <section class="card">
        <span class="status is-error">{{ status }}</span>
        <h1>{{ message }}</h1>
        <p class="lead">Something went wrong. If you contact support, quote the request ID below.</p>
        <if test="requestId"><p class="request-id">Request ID <code class="path">{{ requestId }}</code></p></if>
    </section>
</layout>
