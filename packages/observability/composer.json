{
    "name": "trunkphp/observability",
    "description": "Metrics (Prometheus text format) and log-based tracing for Trunk.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Trunk\\Telemetry\\": "src/"
        }
    },
    "extra": {
        "trunk": {
            "capability": {
                "id": "observability",
                "name": "Observability",
                "description": "Metrics and log-based tracing",
                "modules": [
                    "Trunk\\Telemetry\\TelemetryModule"
                ],
                "requires": [
                    "logging"
                ],
                "config": {
                    "observability": "resources/config/observability.php"
                }
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
