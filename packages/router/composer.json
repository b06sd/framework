{
    "name": "trunkphp/router",
    "description": "Compilable, ReDoS-safe HTTP router for Trunk.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5 || >=8.5.12 <9.0",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Trunk\\Router\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
